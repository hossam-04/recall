# Copy to .env and fill in. .env is gitignored and must never be committed.
DATABASE_URL=postgres://localhost:5432/recall
PORT=3000

# Only needed from M4 onward. Alternative: `ant auth login`, which stores a
# profile the SDK reads with no env var set.
ANTHROPIC_API_KEY=

# Refuse generation past this many cents per user per month (M5).
GENERATION_BUDGET_CENTS_PER_MONTH=500
